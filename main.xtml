<div class="toast" id="toast">✅ Скопировано в буфер обмена!</div>

<script>
  // ===== DATABASE =====
  function getDB() {
    const defaultDB = {
      'TRIAL-2DAY-X7K9-M4P2': { type: 'trial', expiresAt: Date.now() + 48*60*60*1000 },
      'TEST-48HR-B3N8-Q5W1': { type: 'trial', expiresAt: Date.now() + 48*60*60*1000 },
      'DEMO-2DAY-V9C2-L6Z8': { type: 'trial', expiresAt: Date.now() + 48*60*60*1000 }
    };
    const stored = localStorage.getItem('gg_vpn_keys_db');
    return stored ? JSON.parse(stored) : defaultDB;
  }

  const mainConfig = "vless://2c634977-584e-4e1f-b501-1b70c77a6743@185.141.227.180:2053?encryption=none&security=tls&sni=dismissaltree.net&alpn=h2%2C%20http%2F1.1&fp=random&type=xhttp&mode=auto&host=dismissaltree.net&path=%2Fapi%2Fv1%2Fupload#%F0%9F%87%AB%F0%9F%87%AE%D0%90%D0%BD%D1%82%D0%B8%20%D0%B1%D0%B5%D0%BB%D1%8B%D0%B5%20%D1%81%D0%BF%D0%B8%D1%81%D0%BA%D0%B8";

  const testConfigs = {
    fi: "vless://2c634977-584e-4e1f-b501-1b70c77a6743@185.141.227.180:2053?encryption=none&security=tls&sni=dismissaltree.net&alpn=h2%2C%20http%2F1.1&fp=random&type=xhttp&mode=auto&host=dismissaltree.net&path=%2Fapi%2Fv1%2Fupload#%F0%9F%87%AB%F0%9F%87%AE%D0%90%D0%BD%D1%82%D0%B8%20%D0%B1%D0%B5%D0%BB%D1%8B%D0%B5%20%D1%81%D0%BF%D0%B8%D1%81%D0%BA%D0%B8",
    nl: "vless://2c634977-584e-4e1f-b501-1b70c77a6743@185.141.227.180:2053?encryption=none&security=tls&sni=dismissaltree.net&type=xhttp&mode=auto&host=dismissaltree.net&path=%2Fapi%2Fv1%2Fupload&extra=%7B%22host%22%3A%22%22%2C%22path%22%3A%22%22%2C%22mode%22%3A%22%22%2C%22xPaddingBytes%22%3A%22100-1000%22%2C%22xPaddingObfsMode%22%3Afalse%2C%22xPaddingKey%22%3A%22%22%2C%22xPaddingHeader%22%3A%22%22%2C%22xPaddingPlacement%22%3A%22%22%2C%22xPaddingMethod%22%3A%22%22%2C%22uplinkHTTPMethod%22%3A%22%22%2C%22sessionIDPlacement%22%3A%22%22%2C%22sessionIDKey%22%3A%22%22%2C%22sessionIDTable%22%3A%22%22%2C%22sessionIDLength%22%3A%220%22%2C%22seqPlacement%22%3A%22%22%2C%22seqKey%22%3A%22%22%2C%22uplinkDataPlacement%22%3A%22%22%2C%22uplinkDataKey%22%3A%22%22%2C%22uplinkChunkSize%22%3A%220%22%2C%22noGRPCHeader%22%3Afalse%2C%22noSSEHeader%22%3Afalse%2C%22scMaxEachPostBytes%22%3A%221000000%22%2C%22scMinPostsIntervalMs%22%3A%2230%22%2C%22scMaxBufferedPosts%22%3A0.0%2C%22scStreamUpServerSecs%22%3A%220%22%2C%22serverMaxHeaderBytes%22%3A0.0%2C%22xmux%22%3A%7B%22maxConcurrency%22%3A%2216-32%22%2C%22maxConnections%22%3A%220%22%2C%22cMaxReuseTimes%22%3A%2264-128%22%2C%22hMaxRequestTimes%22%3A%220%22%2C%22hMaxReusableSecs%22%3A%220%22%2C%22hKeepAlivePeriod%22%3A0.0%7D%7D#%F0%9F%87%B3%F0%9F%87%B1%D0%B0%D0%BD%D1%82%D0%B8%20%D0%B1%D0%B5%D0%BB%D1%8B%D0%B5%20%D1%81%D0%BF%D0%B8%D1%81%D0%BA%D0%B8%202",
    us: "vless://2c634977-584e-4e1f-b501-1b70c77a6743@185.141.227.180:2053?encryption=none&security=tls&sni=dismissaltree.net&fp=random&type=xhttp&mode=auto&host=dismissaltree.net&path=%2Fapi%2Fv1%2Fupload#%F0%9F%87%BA%F0%9F%87%B8%D0%B1%D1%8B%D1%81%D1%82%D1%80%D1%8B%D0%B9%201"
  };

  const expiredConfigs = [
    "vless://warning@0.0.0.0:1?type=tcp&security=reality&pbk=dE3wtv44FXcZGAp0MYiYYa79z_JlcVNmPN5t8qa0cTs&fp=chrome&sni=zieng2.org&sid=d3&spx=%2F&flow=xtls-rprx-vision#Ваша%20подписка%20устарела!",
    "vless://warning@0.0.0.0:1?type=tcp&security=reality&pbk=dkvpi6EugCxGdX80VFiAU4LtuakJn8MKtrN2BJGfnnQ&fp=chrome&sni=zieng2.org&sid=b2&spx=%2F&flow=xtls-rprx-vision#Новая%20версия%20в%20репозитории",
    "vless://warning@0.0.0.0:1?type=tcp&security=reality&pbk=w7WIGludzG_nDV1JiMg0FWJWrwJh6SSM1dDXfWNOwT0&fp=chrome&sni=zieng2.org&sid=c4&spx=%2F&flow=xtls-rprx-vision#https://github.com/zieng2/wl"
  ];

  // ===== TABS =====
  function switchTab(tabName) {
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
    if (tabName === 'own-key') {
      document.querySelectorAll('.tab-btn')[0].classList.add('active');
      document.getElementById('tab-own-key').classList.add('active');
    } else {
      document.querySelectorAll('.tab-btn')[1].classList.add('active');
      document.getElementById('tab-test-key').classList.add('active');
      updateTestConfig();
    }
  }

  // ===== RENDER CONFIGS =====
  function renderConfigItem(configValue, container) {
    const decodedLabel = decodeURIComponent(configValue.split('#').pop());
    const encodedUrl = encodeURIComponent(configValue);
    const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodedUrl}`;
    
    const div = document.createElement('div');
    div.className = 'config-item';
    div.innerHTML = `
      <span class="config-label">${decodedLabel}</span>
      ${configValue}
      <div class="config-actions">
        <button class="btn-action" onclick="copyConfig(this, '${configValue}')">📋 Копировать</button>
        <button class="btn-action" onclick="showQR('${qrApiUrl}')">📱 QR-код</button>
      </div>
    `;
    container.appendChild(div);
  }

  function updateTestConfig() {
    const serverCode = document.getElementById('serverSelect').value;
    const container = document.getElementById('testConfigContainer');
    container.innerHTML = '';
    renderConfigItem(testConfigs[serverCode], container);
  }

  // ===== KEY INPUT =====
  const keyInput = document.getElementById('keyInput');
  keyInput.addEventListener('input', function(e) {
    let val = e.target.value.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
    let formatted = '';
    for (let i = 0; i < val.length && i < 16; i++) {
      if (i > 0 && i % 4 === 0) formatted += '-';
      formatted += val[i];
    }
    e.target.value = formatted;
  });

  function renderConfigs(containerId, configList, isExpired) {
    const container = document.getElementById(containerId);
    container.style.display = 'block';
    container.innerHTML = '';
    
    const notice = document.createElement('div');
    notice.className = isExpired ? 'expired-notice' : 'test-notice';
    notice.innerHTML = isExpired 
      ? '⚠️ <strong>Срок действия ключа истёк (прошло 48 часов).</strong><br>Напишите @error430r для продления подписки.'
      : '✅ <strong>Активная подписка!</strong> Скопируйте конфигурацию или отсканируйте QR-код.<br><small>Ключ действителен 48 часов с момента активации.</small>';
    container.appendChild(notice);

    const list = document.createElement('div');
    list.className = 'config-list';
    configList.forEach(cfg => renderConfigItem(cfg, list));
    container.appendChild(list);
  }

  // ===== ACTIVATE KEY =====
  async function activateKey() {
    const key = keyInput.value.trim().toUpperCase();
    const successMsg = document.getElementById('successMsg');
    const errorMsg = document.getElementById('errorMsg');
    const resultContainer = document.getElementById('own-key-result');
    const btn = document.querySelector('.btn-activate');

    successMsg.style.display = 'none';
    errorMsg.style.display = 'none';
    resultContainer.style.display = 'none';
    
    btn.textContent = 'Проверка...';
    btn.disabled = true;
    await new Promise(r => setTimeout(r, 600));

    const db = getDB();
    const record = db[key];

    if (!record) {
      errorMsg.style.display = 'block';
      errorMsg.textContent = '❌ Ключ не найден. Напишите @error430r для получения ключа.';
    } else {
      const isExpired = Date.now() > record.expiresAt;
      successMsg.style.display = 'block';
      renderConfigs('own-key-result', isExpired ? expiredConfigs : [mainConfig], isExpired);
    }

    btn.textContent = 'Активировать';
    btn.disabled = false;
  }

  // ===== COPY & QR =====
  function copyConfig(btn, text) {
    navigator.clipboard.writeText(text).then(() => {
      showToast('✅ Скопировано в буфер обмена!');
      btn.classList.add('copied');
      btn.innerHTML = '✓ Скопировано';
      setTimeout(() => { 
        btn.classList.remove('copied'); 
        btn.innerHTML = '📋 Копировать'; 
      }, 2000);
    });
  }

  function showQR(qrUrl) {
    document.getElementById('qrImage').src = qrUrl;
    document.getElementById('qrModalOverlay').classList.add('active');
  }
  function closeQrModal() {
    document.getElementById('qrModalOverlay').classList.remove('active');
  }

  function showToast(message) {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2500);
  }

  // ===== MODAL (TELEGRAM) =====
  function openModal(planText) {
    document.getElementById('modalOverlay').classList.add('active');
    document.getElementById('modalPlanText').textContent = planText || 'Выбранный тариф';
  }
  function closeModal() { document.getElementById('modalOverlay').classList.remove('active'); }
  document.getElementById('modalOverlay').addEventListener('click', function(e) { if (e.target === this) closeModal(); });
  document.getElementById('qrModalOverlay').addEventListener('click', function(e) { if (e.target === this) closeQrModal(); });

  // ===== FAQ ACCORDION =====
  function toggleFaq(element) {
    const item = element.parentElement;
    const isActive = item.classList.contains('active');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('active'));
    if (!isActive) item.classList.add('active');
  }

  // ===== INIT & ANIMATIONS =====
  window.addEventListener('DOMContentLoaded', () => {
    updateTestConfig();
    const observer = new IntersectionObserver((entries) => { entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); }); }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
  });

  document.querySelectorAll('a[href^="#"]').forEach(anchor => { anchor.addEventListener('click', function(e) { e.preventDefault(); const target = document.querySelector(this.getAttribute('href')); if (target) target.scrollIntoView({ behavior: 'smooth' }); }); });
</script>

</body>
</html>
